---
import SiloLinks from '../components/SiloLinks.astro';
import LeadForm from '../components/LeadForm.astro';
import CookieBanner from '../components/CookieBanner.astro';
import type { SiloPageEntry } from '../utils/siloLinking';
import {
  buildLocalBusinessSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
} from '../utils/schemaBuilder';

interface Props {
  title: string;
  description: string;
  h1: string;
  currentPage: SiloPageEntry;
  allPages: SiloPageEntry[];
  landmarks?: string[];
  neighborhoodContext?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  h1,
  currentPage,
  allPages,
  landmarks = [],
  neighborhoodContext,
  image,
  imageAlt,
} = Astro.props;

const siteOrigin = Astro.site?.origin || 'https://airesacondicionadoscancun.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);

const ogImageUrl = image
  ? (image.startsWith('http://') || image.startsWith('https://')
      ? image
      : new URL(image, siteOrigin).toString())
  : `${siteOrigin}/og-image.jpg`;

const ogImageAlt = imageAlt || h1 || title;

const localBusinessSchema = buildLocalBusinessSchema();
const breadcrumbSchema = buildBreadcrumbSchema(currentPage, h1, canonicalURL.toString());
const serviceSchema = buildServiceSchema(currentPage, canonicalURL.toString());
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- Google Consent Mode v2 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Initialize default consent states based on saved user preference
      const savedConsent = typeof localStorage !== 'undefined' && localStorage.getItem('cookies_accepted') === 'true';
      gtag('consent', 'default', {
        'analytics_storage': savedConsent ? 'granted' : 'denied',
        'ad_storage': savedConsent ? 'granted' : 'denied',
        'ad_user_data': savedConsent ? 'granted' : 'denied',
        'ad_personalization': savedConsent ? 'granted' : 'denied',
        'wait_for_update': 500
      });
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MGTFH4KB');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Aires Acondicionados Cancún" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    {serviceSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    )}

    <style is:global>
      :root {
        --color-primary: #0284c7;
        --color-primary-dark: #0369a1;
        --color-accent: #06b6d4;
        --color-bg-dark: #090d16;
        --color-bg-light: #f8fafc;
        --color-card-bg: #ffffff;
        --color-text-main: #1e293b;
        --color-text-muted: #64748b;
        --color-success: #16a34a;

        --font-heading: 'Outfit', sans-serif;
        --font-body: 'Inter', sans-serif;

        --max-width: 1240px;
        --radius: 16px;
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.06), 0 2px 4px -2px rgba(0,0,0,0.06);
        --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -6px rgba(0,0,0,0.04);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        overflow-x: hidden;
      }

      body {
        font-family: var(--font-body);
        background-color: var(--color-bg-light);
        color: var(--color-text-main);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
        font-weight: 700;
        color: #0f172a;
        line-height: 1.25;
        margin-bottom: 0.85rem;
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: all 0.2s ease;
      }

      a:hover {
        color: var(--color-primary-dark);
      }

      /* === Mobile-First Header Bar (Base: 320px+) === */
      .header {
        background: rgba(9, 13, 22, 0.94);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: #ffffff;
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
      }

      .header-container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0.75rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
      }

      .logo-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .logo-icon {
        background: linear-gradient(135deg, #06b6d4, #0284c7);
        color: #ffffff;
        font-weight: 800;
        font-size: 1rem;
        padding: 0.35rem 0.65rem;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
        flex-shrink: 0;
      }

      .logo-text {
        font-family: var(--font-heading);
        font-size: clamp(1rem, 3.8vw, 1.35rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #ffffff;
        line-height: 1.2;
      }

      .logo-sub {
        display: none;
        font-size: 0.75rem;
        color: #38bdf8;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        flex-shrink: 0;
      }

      .btn-phone {
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.55rem 0.95rem;
        min-height: 44px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        box-shadow: 0 4px 14px rgba(22, 163, 74, 0.35);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        white-space: nowrap;
      }

      .btn-phone:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(22, 163, 74, 0.45);
        color: #ffffff;
      }

      /* === Mobile-First Hero Section (Base: 320px+) === */
      .hero {
        background: radial-gradient(circle at top right, #1e293b, #090d16);
        color: #ffffff;
        padding: 2.25rem 1rem 2rem 1rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: var(--max-width);
        height: 100%;
        background: radial-gradient(circle at center, rgba(2, 132, 199, 0.15) 0%, transparent 70%);
        pointer-events: none;
      }

      .hero-content {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
      }

      .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(6, 182, 212, 0.15);
        border: 1px solid rgba(6, 182, 212, 0.3);
        color: #38bdf8;
        font-size: 0.775rem;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        margin-bottom: 0.85rem;
      }

      .hero h1 {
        color: #ffffff;
        font-size: clamp(1.45rem, 5vw + 0.2rem, 2.75rem);
        letter-spacing: -0.02em;
        margin-bottom: 0.85rem;
        line-height: 1.25;
        word-break: break-word;
      }

      .hero p {
        font-size: clamp(0.975rem, 2vw + 0.5rem, 1.15rem);
        color: #cbd5e1;
        max-width: 820px;
        margin: 0 auto 1.25rem auto;
      }

      .badge-group {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .badge {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 0.35rem 0.75rem;
        border-radius: 30px;
        font-size: 0.775rem;
        font-weight: 500;
        color: #f1f5f9;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }

      /* === Mobile-First Main Content Layout (Base: 320px+) === */
      .main-layout {
        width: 100%;
        max-width: var(--max-width);
        margin: 1.25rem auto;
        padding: 0 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        flex: 1;
      }

      .content-card {
        background: var(--color-card-bg);
        border-radius: 12px;
        padding: 1.5rem 1.15rem;
        box-shadow: var(--shadow-lg);
        border: 1px solid #e2e8f0;
      }

      .content-card h2 {
        font-size: clamp(1.35rem, 3.5vw, 1.6rem);
        margin-top: 1.5rem;
        color: #0f172a;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 0.5rem;
      }

      .content-card h3 {
        font-size: clamp(1.15rem, 2.5vw, 1.3rem);
        margin-top: 1.25rem;
        color: #0284c7;
      }

      .content-card p {
        margin-bottom: 1.25rem;
        color: #334155;
        font-size: clamp(0.95rem, 1.5vw, 1.05rem);
      }

      .content-card ul, .content-card ol {
        margin-left: 1.25rem;
        margin-bottom: 1.25rem;
        color: #334155;
      }

      .content-card li {
        margin-bottom: 0.5rem;
        font-size: clamp(0.95rem, 1.5vw, 1.05rem);
      }

      .sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .context-box {
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-left: 5px solid var(--color-primary);
        padding: 1.25rem 1rem;
        border-radius: 12px;
        margin-top: 1.5rem;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
      }

      .context-box h3 {
        font-size: 1.15rem;
        margin-top: 0;
        color: #0f172a;
        margin-bottom: 0.4rem;
      }

      .context-box p {
        font-size: 0.925rem;
        color: #475569;
        margin-bottom: 0.4rem;
      }

      /* Floating 24/7 AI Voice / WhatsApp Widget */
      .floating-widget {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        z-index: 999;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: flex-end;
      }

      .float-btn {
        background: #25d366;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.65rem 1.1rem;
        min-height: 44px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        white-space: nowrap;
      }

      .float-btn:hover {
        transform: scale(1.05);
        color: #ffffff;
        box-shadow: 0 12px 30px rgba(37, 211, 102, 0.5);
      }

      /* === Mobile-First Footer (Base: 320px+) === */
      .footer {
        background-color: var(--color-bg-dark);
        color: #94a3b8;
        padding: 2.5rem 1rem 1.5rem 1rem;
        margin-top: auto;
      }

      .footer-container {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer-bottom {
        border-top: 1px solid #1e293b;
        margin-top: 2rem;
        padding-top: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        font-size: 0.85rem;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem 1.25rem;
      }

      .footer-links a {
        color: #94a3b8;
      }

      .footer-links a:hover {
        color: #ffffff;
      }

      /* === Progressive Enhancement Breakpoints (min-width) === */

      /* Tablet & Small Screens (>= 640px) */
      @media (min-width: 640px) {
        .header-container {
          padding: 1rem 1.25rem;
        }

        .logo-icon {
          font-size: 1.2rem;
          padding: 0.45rem 0.85rem;
        }

        .logo-sub {
          display: block;
        }

        .btn-phone {
          padding: 0.65rem 1.35rem;
          font-size: 0.95rem;
        }

        .hero {
          padding: 3rem 1.5rem 2.5rem 1.5rem;
        }

        .hero-pill {
          font-size: 0.875rem;
          padding: 0.35rem 1rem;
          margin-bottom: 1.25rem;
        }

        .badge-group {
          gap: 0.75rem;
        }

        .badge {
          font-size: 0.875rem;
          padding: 0.45rem 0.95rem;
        }

        .main-layout {
          padding: 0 1.25rem;
          margin: 1.75rem auto;
        }

        .content-card {
          padding: 2rem 1.75rem;
        }

        .context-box {
          padding: 1.5rem;
        }

        .float-btn {
          padding: 0.85rem 1.4rem;
          font-size: 0.95rem;
        }

        .footer {
          padding: 3.5rem 1.5rem 1.75rem 1.5rem;
        }

        .footer-bottom {
          flex-direction: row;
          justify-content: space-between;
          text-align: left;
        }
      }

      /* Desktop Screens (>= 1024px) */
      @media (min-width: 1024px) {
        .header-container {
          padding: 1rem 1.5rem;
        }

        .hero {
          padding: 4rem 1.5rem 3.5rem 1.5rem;
        }

        .main-layout {
          display: grid;
          grid-template-columns: 1fr 360px;
          gap: 2.5rem;
          margin: 2.5rem auto;
          padding: 0 1.5rem;
        }

        .content-card {
          padding: 2.75rem;
          border-radius: var(--radius);
        }

        .floating-widget {
          bottom: 1.75rem;
          right: 1.75rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MGTFH4KB"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header class="header">
      <div class="header-container">
        <a href="/" class="logo-group" aria-label="Aires Acondicionados Cancún Inicio">
          <div class="logo-icon">AC</div>
          <div>
            <div class="logo-text">Aires Acondicionados Cancún</div>
            <span class="logo-sub">Servicio Técnico Especializado 24/7</span>
          </div>
        </a>
        <div class="nav-actions">
          <a href="https://wa.me/529984934110?text=Hola,%20requiero%20asistencia%20técnica%20de%20aire%20acondicionado%20en%20Cancún" target="_blank" class="btn-phone" aria-label="Contactar por WhatsApp 24/7">
            <span>💬 WhatsApp 24/7</span>
          </a>
        </div>
      </div>
    </header>

    <section class="hero">
      <div class="hero-content">
        <div class="hero-pill font-heading">
          <span>✨</span> Recepción de Llamadas y Atención de Urgencias 24h
        </div>
        <h1>{h1}</h1>
        <p>{description}</p>
        <div class="badge-group">
          <span class="badge">⚡ Respuesta Express &lt; 90 min</span>
          <span class="badge">🛡️ Garantía Física 90-365 Días</span>
          <span class="badge">❄️ Especialistas Inverter (Mirage, York, Carrier)</span>
          <span class="badge">⭐ 4.9/5 Reseñas de Clientes</span>
        </div>
      </div>
    </section>

    <div class="main-layout">
      <main class="content-card">
        <slot />

        {neighborhoodContext && (
          <div class="context-box">
            <h3>📍 Cobertura y Contexto Local</h3>
            <p>{neighborhoodContext}</p>
            {landmarks.length > 0 && (
              <p><strong>Referencias y puntos cercanos:</strong> {landmarks.join(', ')}</p>
            )}
          </div>
        )}
      </main>

      <aside class="sidebar">
        <LeadForm />
      </aside>
    </div>

    <!-- Floating 24/7 AI Voice & WhatsApp Contact Button -->
    <div class="floating-widget">
      <a href="https://wa.me/529984934110?text=Hola,%20necesito%20cotizar%20un%20servicio%20de%20aire%20acondicionado%20en%20Cancún" target="_blank" class="float-btn" aria-label="Solicitar cotización por WhatsApp">
        <span>💬 Solicitar Asistencia 24/7</span>
      </a>
    </div>

    <footer class="footer">
      <div class="footer-container">
        <SiloLinks currentPage={currentPage} allPages={allPages} />

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Aires Acondicionados Cancún. Todos los derechos reservados.</p>
          <div class="footer-links">
            <a href="/privacidad">Aviso de Privacidad</a>
            <a href="/terminos">Términos y Condiciones</a>
            <a href="https://hstrejoluna-monorepo-portfolio.vercel.app/" target="_blank" rel="noopener noreferrer">Desarrollado por HS Trejo Luna</a>
          </div>
        </div>
      </div>
    </footer>

    <CookieBanner />
  </body>
</html>
